#include <windows.h>
#include "resource.h"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_PATCH@,@VERSION_BUILD@
  PRODUCTVERSION @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_PATCH@,@VERSION_BUILD@
  FILEFLAGSMASK 0x3f
  FILEFLAGS 0x0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "deltarec"
      VALUE "FileDescription",  "deltarec PCM to 1-bit DSD Converter for foobar2000"
      VALUE "FileVersion",      "@VERSION_MAJOR@.@VERSION_MINOR@.@VERSION_PATCH@.@VERSION_BUILD@"
      VALUE "InternalName",     "foo_deltarec"
      VALUE "LegalCopyright",   "MIT License"
      VALUE "OriginalFilename", "foo_deltarec.dll"
      VALUE "ProductName",      "foo_deltarec"
      VALUE "ProductVersion",   "@FOO_DELTAREC_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

IDD_DELTAREC_DIALOG DIALOGEX 0, 0, 340, 238
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Convert to DSD (deltarec)"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Selected tracks:", IDC_TRACK_INFO_STATIC, 10, 8, 320, 10

    GROUPBOX        "DSD Conversion Settings", -1, 7, 22, 326, 114
    LTEXT           "DSD Rate:", -1, 16, 37, 72, 10
    COMBOBOX        IDC_RATE_COMBO, 95, 35, 228, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Base Clock Family:", -1, 16, 55, 72, 10
    COMBOBOX        IDC_BASE_COMBO, 95, 53, 228, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Output Format:", -1, 16, 73, 72, 10
    COMBOBOX        IDC_FORMAT_COMBO, 95, 71, 228, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Modulator Order:", -1, 16, 91, 72, 10
    COMBOBOX        IDC_ORDER_COMBO, 95, 89, 65, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Gain (dB):", -1, 175, 91, 42, 10
    EDITTEXT        IDC_GAIN_EDIT, 220, 89, 45, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "(0 = 50% SACD)", -1, 270, 91, 56, 10

    CONTROL         "Enable TPDF Dither (0.05)", IDC_DITHER_CHECK, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 16, 108, 130, 10
    CONTROL         "Copy source tags && album art (ID3v2)", IDC_COPY_TAGS_CHECK, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 155, 108, 168, 10

    GROUPBOX        "Output Destination", -1, 7, 140, 326, 70
    CONTROL         "Save in the same folder as each source track", IDC_SAME_FOLDER_CHECK, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 16, 153, 300, 10

    LTEXT           "Output Folder:", -1, 16, 170, 72, 10
    EDITTEXT        IDC_OUTDIR_EDIT, 95, 168, 175, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse...", IDC_BROWSE_BTN, 274, 168, 50, 14, WS_TABSTOP

    LTEXT           "File Naming:", -1, 16, 189, 72, 10
    COMBOBOX        IDC_NAMING_COMBO, 95, 187, 228, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    DEFPUSHBUTTON   "Convert", IDOK, 222, 217, 52, 15, WS_TABSTOP
    PUSHBUTTON      "Cancel", IDCANCEL, 281, 217, 52, 15, WS_TABSTOP
END
